<!-- ZeroTrace Signal V8.34.0 // live executed order flow + trading signal + network signal --><!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport"/>
<meta content="#05070a" name="theme-color"/>
<meta content="ZeroTrace — interactive Zcash privacy education. See what observers can learn from transparent and shielded transaction paths, then verify with live network data." name="description"/>
<meta content="dark" name="color-scheme"/>
<title>Zcash Analytics // ZeroTrace</title>
<style>
:root{
  --bg:#05070a;--bg2:#080b10;--panel:#0a0f14;--panel2:#0d131a;--line:#1b2832;--line2:#263944;
  --text:#eef4f0;--muted:#82918a;--muted2:#5f6d67;--green:#7dff9b;--green2:#37d86a;
  --cyan:#67d8ff;--purple:#b583ff;--amber:#ffd166;--red:#ff7272;
  --mono:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;--sans:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;color:var(--text);font-family:var(--sans);line-height:1.55;background:
radial-gradient(circle at 75% -5%,rgba(103,216,255,.08),transparent 28%),
radial-gradient(circle at 18% 14%,rgba(125,255,155,.055),transparent 24%),var(--bg);overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:999;opacity:.16;background:repeating-linear-gradient(180deg,transparent 0 3px,rgba(255,255,255,.015) 4px);mix-blend-mode:screen}
a{color:inherit}.wrap{width:min(1180px,92%);margin:auto}.mono{font-family:var(--mono)}.muted{color:var(--muted)}.g{color:var(--green)}.c{color:var(--cyan)}.p{color:var(--purple)}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
nav{position:sticky;top:0;z-index:60;border-bottom:1px solid rgba(38,57,68,.7);background:rgba(5,7,10,.82);backdrop-filter:blur(18px)}.navin{height:64px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;gap:10px;align-items:center;text-decoration:none;font:800 14px var(--mono);letter-spacing:.13em;color:var(--green)}.brandmark{width:23px;height:23px;border:1px solid #315942;border-radius:6px;display:grid;place-items:center;box-shadow:0 0 20px rgba(125,255,155,.08)}.navlinks{display:flex;gap:18px;overflow:auto}.navlinks a{font:11px var(--mono);letter-spacing:.06em;text-decoration:none;color:var(--muted);white-space:nowrap}.navlinks a:hover{color:var(--green)}
.hero{min-height:760px;padding:90px 0 72px;border-bottom:1px solid var(--line);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;right:-180px;top:40px;width:650px;height:650px;border:1px solid rgba(125,255,155,.08);border-radius:50%;box-shadow:0 0 0 55px rgba(103,216,255,.018),0 0 0 110px rgba(181,131,255,.012);pointer-events:none}.heroGrid{display:grid;grid-template-columns:1.15fr .85fr;gap:48px;align-items:center;position:relative;z-index:2}.eyebrow{font:11px var(--mono);color:var(--green);letter-spacing:.19em;text-transform:uppercase}.hero h1{font:800 clamp(46px,7.2vw,88px)/.93 var(--mono);letter-spacing:-.065em;margin:18px 0 24px;max-width:850px}.hero h1 .ghost{color:transparent;-webkit-text-stroke:1px rgba(238,244,240,.33)}.heroLead{font-size:18px;color:#aab6af;max-width:720px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;min-height:43px;padding:0 15px;border:1px solid var(--line2);border-radius:8px;text-decoration:none;font:700 11px var(--mono);letter-spacing:.04em;background:rgba(10,15,20,.55);cursor:pointer;color:var(--text)}.btn.primary{background:var(--green);border-color:var(--green);color:#031006}.btn:hover{transform:translateY(-1px);border-color:#42614d}.heroVisual{min-height:470px;display:grid;place-items:center;position:relative}.orb{width:min(390px,82vw);aspect-ratio:1;border-radius:50%;position:relative;background:radial-gradient(circle at 50% 50%,rgba(125,255,155,.16),rgba(4,12,9,.76) 41%,rgba(5,7,10,.96) 70%);border:1px solid rgba(125,255,155,.16);box-shadow:inset 0 0 80px rgba(125,255,155,.035),0 0 80px rgba(0,0,0,.55)}.orb:before,.orb:after{content:"";position:absolute;inset:8%;border-radius:50%;border:1px solid rgba(103,216,255,.18)}.orb:after{inset:19%;border-color:rgba(181,131,255,.22)}.hood{position:absolute;left:50%;top:50%;transform:translate(-50%,-47%);width:48%;height:61%;clip-path:polygon(50% 0,88% 18%,100% 100%,0 100%,12% 18%);background:linear-gradient(145deg,#111b1c,#050809 62%);border-radius:48% 48% 20% 20%;filter:drop-shadow(0 0 22px rgba(125,255,155,.09))}.face{position:absolute;left:50%;top:36%;transform:translateX(-50%);width:37%;height:34%;border-radius:48% 48% 43% 43%;background:radial-gradient(circle at 50% 40%,#16201f,#030404 67%);box-shadow:0 0 0 1px rgba(255,255,255,.03)}.eyes{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);width:60%;height:4px;background:linear-gradient(90deg,transparent,var(--green),transparent);box-shadow:0 0 18px var(--green)}.orbCode{position:absolute;font:9px/1.6 var(--mono);color:#566b60;white-space:pre;opacity:.55}.orbCode.a{left:-8%;top:13%}.orbCode.b{right:-8%;bottom:14%;text-align:right}.pulseBadge{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);font:10px var(--mono);color:var(--green);padding:7px 10px;background:#07100a;border:1px solid #23402b;border-radius:999px;white-space:nowrap}.pulseDot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:7px;box-shadow:0 0 14px var(--green);animation:pulse 1.5s infinite}@keyframes pulse{50%{opacity:.45}}
section{padding:78px 0;border-bottom:1px solid var(--line)}.sectionhead{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:28px}.sectionhead h2{font:800 clamp(27px,4.4vw,44px)/1 var(--mono);letter-spacing:-.045em;margin:0}.sectionhead p{max-width:560px;margin:0;color:var(--muted);font-size:13px}.tag{font:10px var(--mono);color:var(--green);border:1px solid #284831;background:#07100a;padding:6px 9px;border-radius:999px;white-space:nowrap}
.pulseStrip{display:grid;grid-template-columns:repeat(7,1fr);border:1px solid var(--line);background:linear-gradient(180deg,#0a0f14,#070b0f);border-radius:12px;overflow:hidden;margin-bottom:18px}.pulseItem{padding:16px;border-right:1px solid var(--line);min-width:0}.pulseItem:last-child{border-right:0}.pulseItem .label{font:9px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.pulseItem .value{font:800 17px var(--mono);margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.pulseItem .sub{font:9px var(--mono);color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dataMeta{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding:10px 12px;border:1px solid var(--line);border-radius:8px;background:#070a0d;font:10px var(--mono);color:var(--muted);margin-bottom:18px}.state.live{color:var(--green)}.state.stale{color:var(--amber)}.state.dead{color:var(--red)}.verifyLink{color:var(--cyan);text-decoration:none}.verifyLink:hover{text-decoration:underline}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:11px;padding:18px;position:relative;overflow:hidden}.kpi:after{content:"";position:absolute;inset:auto 0 0;height:2px;background:linear-gradient(90deg,transparent,var(--accent,var(--green)),transparent);opacity:.55}.kpi .label{font:10px var(--mono);letter-spacing:.055em;color:var(--muted);text-transform:uppercase}.kpi .value{font:800 25px var(--mono);margin:8px 0 4px}.kpi .note{font:10px var(--mono);color:var(--muted)}.kpi.cyan{--accent:var(--cyan)}.kpi.purple{--accent:var(--purple)}.kpi.amber{--accent:var(--amber)}
.chartToolbar{display:flex;gap:7px;flex-wrap:wrap}.rangeBtn{background:#080d11;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:9px var(--mono);cursor:pointer}.rangeBtn.active,.rangeBtn:hover{color:var(--green);border-color:#2d5137}.chartgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px}.chartbox{background:linear-gradient(180deg,#0a0f14,#080c10);border:1px solid var(--line);border-radius:12px;padding:17px;min-height:310px;position:relative}.charttop{display:flex;justify-content:space-between;gap:10px;align-items:start;margin-bottom:7px}.chartbox h3{font:700 12px var(--mono);margin:0}.chartbox .chartValue{font:800 16px var(--mono);color:var(--green);margin-top:4px}.chartbox canvas{width:100%;height:220px;display:block;touch-action:pan-y;cursor:crosshair;-webkit-tap-highlight-color:transparent}.chartnote{font:9px var(--mono);color:var(--muted);margin-top:8px}.shareMini{background:transparent;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:9px var(--mono);cursor:pointer}.shareMini:hover{color:var(--green);border-color:#31563c}.chartTip{position:absolute;pointer-events:none;display:none;background:#020405;border:1px solid #2b3d35;border-radius:7px;padding:7px 9px;font:9px var(--mono);color:#cbd6d0;z-index:5;box-shadow:0 10px 28px rgba(0,0,0,.4)}
.signalGrid{display:grid;grid-template-columns:1.1fr .9fr;gap:14px}.signal{background:radial-gradient(circle at 82% 0,rgba(244,183,40,.07),transparent 34%),linear-gradient(180deg,#090a09,#050706);border:1px solid #493918;border-radius:12px;padding:25px;min-height:220px;box-shadow:inset 0 0 35px rgba(244,183,40,.018)}.signal .screen{font:10px/1.9 var(--mono);color:#7f837e;letter-spacing:.035em}.signal .screen b{color:#F4B728;font-weight:700}.signal .bigSignal{font:800 clamp(25px,4vw,43px)/1.04 var(--mono);letter-spacing:-.045em;color:#F4B728;margin:15px 0;text-shadow:0 0 22px rgba(244,183,40,.08)}.signal .subSignal{font:11px/1.75 var(--mono);color:#c1c5c0}.signalTicker{margin-top:14px;padding-top:12px;border-top:1px solid #282418;font:9px var(--mono);letter-spacing:.06em;color:#8d8f89}.signalTicker b{color:#20F58A}.verifyBox{background:#080c10;border:1px solid var(--line);border-radius:12px;padding:24px}.verifyBox h3{font:800 15px var(--mono);margin:0 0 12px}.verifyBox p{font-size:13px;color:var(--muted)}
.blocks{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:#070b0f}
.blockRow:not(.header){cursor:pointer}.blockDetail{display:none;padding:14px 16px 17px;border-bottom:1px solid var(--line);background:#04080a;font:10px/1.7 var(--mono);color:#9eaaa4}.blockDetail.open{display:block}.blockDetailGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px}.blockDetail b{color:#e8efeb}.blockHash{grid-column:1/-1;word-break:break-all}.miniBtn{margin-top:10px;background:#09110c;color:var(--green);border:1px solid #294b32;border-radius:6px;padding:7px 9px;font:800 9px var(--mono);cursor:pointer}.whyBtn{margin-top:14px;background:transparent;color:var(--green);border:1px solid #31563c;border-radius:7px;padding:8px 11px;font:800 9px var(--mono);cursor:pointer}.signalWhy{display:none;margin-top:12px;padding:12px;border:1px solid var(--line);border-radius:8px;background:#05090b;font:10px/1.65 var(--mono);color:#aab7b0}.signalWhy.open{display:block}.trend{color:var(--green);font-weight:700}.trend.down{color:#ff8f8f}.blockRow{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;padding:13px 15px;border-bottom:1px solid var(--line);font:10px var(--mono)}.blockRow:last-child{border-bottom:0}.blockRow.header{color:var(--muted);background:#0b1015}.blockRow:not(.header):hover{background:#0a1110}.blockHeight{color:var(--green)}
.labShell{display:grid;grid-template-columns:.78fr 1.22fr;gap:14px}.scenarioList{display:grid;gap:8px}.scenario{display:block;width:100%;text-align:left;border:1px solid var(--line);background:#080d11;color:var(--text);border-radius:9px;padding:14px;cursor:pointer}.scenario strong{font:700 11px var(--mono)}.scenario span{display:block;font